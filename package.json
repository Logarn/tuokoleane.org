{
  "name": "tuokoleane-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/prerender-seo.mjs --prepare && vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "seo:csp": "node scripts/prerender-seo.mjs --print-csp-hashes",
    "test": "vitest run",
    "test:seo": "bun run build && node scripts/validate-seo.mjs && node scripts/prerender-seo.mjs --validate-only",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
